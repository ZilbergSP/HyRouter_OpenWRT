#!/bin/sh /etc/rc.common
# HyRouter: routes the LAN through Hysteria 2 and VLESS servers by rules.
# The settings and the web interface: hyrouterd (port 8088 of the router).

START=99
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/hyrouterd -config /etc/hyrouter
	# A crash restarts it at once and forever: until it is back, the
	# table it left refuses VPN traffic instead of sending it direct.
	procd_set_param respawn 3600 5 0
	procd_set_param term_timeout 15
	procd_set_param limits nofile="65535 65535"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
