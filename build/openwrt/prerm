#!/bin/sh
# Stopping removes HyRouter's table and routing rule, and the kill switch
# a stop leaves while routing is on: the LAN goes on as without HyRouter.
# The settings in /etc/hyrouter stay.
[ -n "$IPKG_INSTROOT" ] && exit 0
/etc/init.d/hyrouter stop 2>/dev/null
/etc/init.d/hyrouter disable
/etc/init.d/hyrouter-guard disable
nft delete table inet hyrouter_guard 2>/dev/null
exit 0
